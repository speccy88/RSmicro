{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://schemas.rsmicro.dev/v1/project.schema.json",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "project_id",
    "name",
    "description",
    "controllers",
    "deployments",
    "scada",
    "metadata"
  ],
  "properties": {
    "format": {
      "const": "rsmicro-project"
    },
    "format_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "controllers": {
      "type": "array"
    },
    "deployments": {
      "type": "array"
    },
    "scada": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
