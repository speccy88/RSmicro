{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "https://schemas.rsmicro.dev/v1/tags.schema.json",
  "$defs": {
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag_id",
        "name",
        "data_type",
        "metadata"
      ],
      "properties": {
        "tag_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "data_type": {
          "enum": [
            "BOOL",
            "DINT",
            "REAL",
            "TIMER",
            "COUNTER"
          ]
        },
        "initial_value": {
          "type": [
            "boolean",
            "integer",
            "number",
            "null"
          ]
        },
        "preset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retentive": {
          "type": "boolean"
        },
        "writable": {
          "type": "boolean"
        },
        "access": {
          "type": "object"
        },
        "engineering_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "scada_visible": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
